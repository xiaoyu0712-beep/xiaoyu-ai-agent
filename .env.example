# Server-side only. Never put these values in src/ or GitHub Pages.
# Manus built-in LLM proxy (preferred)
BUILT_IN_FORGE_API_URL=https://your-manus-llm-proxy/v1
BUILT_IN_FORGE_API_KEY=replace-with-server-secret
XIAOYU_LLM_MODEL=gpt-5-mini

# Optional OpenAI-compatible fallback; leave empty when using Manus proxy.
OPENAI_API_BASE=
OPENAI_API_KEY=

# Optional Suna API endpoint for full self-host runtime.
XIAOYU_SUNA_API_URL=http://suna-api:8008/v1
